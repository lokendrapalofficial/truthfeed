generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Article {
  id             String          @id @default(cuid())
  title          String
  url            String          @unique
  content        String
  summary        String?
  imageUrl       String?
  isLogo         Boolean         @default(false)
  isThematic     Boolean         @default(false)
  sourceName     String
  publishedAt    DateTime
  createdAt      DateTime        @default(now())
  factChecks     FactCheck[]
  sourceId       String?
  source         Source?         @relation(fields: [sourceId], references: [id])
  communityNotes CommunityNote[]
  relatedSources Json?
  analysis       Analysis?
  savedBy        User[]
}

model Source {
  id          String      @id @default(cuid())
  name        String      @unique
  bias        Bias
  credibility Credibility
  description String?
  articles    Article[]
}

model FactCheck {
  id                 String   @id @default(cuid())
  claimText          String
  verdict            String
  rating             Rating
  sourceOrganization String
  factCheckUrl       String
  relatedArticleId   String
  relatedArticle     Article  @relation(fields: [relatedArticleId], references: [id])
}

enum Rating {
  TRUE
  FALSE
  MIXED
  UNVERIFIED
}

enum Bias {
  LEFT
  LEAN_LEFT
  CENTER
  LEAN_RIGHT
  RIGHT
}

enum Credibility {
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
  VERY_LOW
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  preferences    Json?           // Stores array of selected interests like ["Tech Markets", "Geopolitics"]
  isPro          Boolean         @default(false)
  createdAt      DateTime        @default(now())
  articles       Article[]       // Relation to saved/bookmarked articles
  communityNotes CommunityNote[]
}

model CommunityNote {
  id         String   @id @default(cuid())
  articleId  String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  sourceUrl  String
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Analysis {
  id           String         @id @default(cuid())
  articleId    String         @unique
  article      Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  claim        String
  briefing     String?
  category     String?
  verification Json?
  framingMatrix Json?
  createdAt    DateTime       @default(now())
  conflictAlert ConflictAlert?
}

model ConflictAlert {
  id         String   @id @default(cuid())
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  claim      String
  category   String?
  createdAt  DateTime @default(now())
}
